# node_modules (web/ carries its own copy too)
node_modules/
web/node_modules/

# build output
web/dist/
dist/

# The family-status@1 emitter's output (regenerated on every web build - see
# web/scripts/build-status.mjs; committing it would be the stale-copy drift
# class the family kills everywhere else - regeneration IS the freshness).
web/public/status.json

# npm pack artifacts
*.tgz
.DS_Store

# local extension packs (packs/public/ is tracked; packs/local/ is private)
packs/local/

# Local docs-preview toolchain: the Jekyll preview recipe runs from a scratch
# copy of docs/ with Bundler's path OUTSIDE the repo, so none of these should
# ever appear - belt-and-suspenders so an accidental in-tree build taints
# nothing.
docs/.bundle/
docs/vendor/
docs/_site/
docs/Gemfile.lock
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/pagefind/
docs/pagefind*
